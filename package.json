{
  "name": "swifty.go",
  "version": "0.0.3",
  "description": "Swifty",
  "keywords": [],
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "type": "module",
  "scripts": {
    "lint": "go list -f '{{.Dir}}/...' -m | xargs golangci-lint run",
    "lint:fix": "go list -f '{{.Dir}}/...' -m | xargs golangci-lint run --fix",
    "tag": "node tag.js",
    "add:licenses": "node scripts/add_licenses.js",
    "git:precommit": "rm -rf ./.claude && ln -s ./.github ./.claude",
    "git:commit": "pnpm git:precommit && git add -A && git commit -m \"feat: Introduce new features\"",
    "git:push": "pnpm git:commit && git push origin main"
  }
}
